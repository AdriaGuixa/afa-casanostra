---
import Layout from '../../layouts/Layout.astro';
const allPosts = Object.values(import.meta.glob('../../content/actualitat/*.md', { eager: true }));
// Ordenar per data (més recents primer)
const sortedPosts = allPosts.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<Layout title="Actualitat i Blog">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-brand-blue mb-8">Actualitat i Blog</h1>
    <p class="text-lg text-slate-600 mb-8">L'històric de circulars enviades a les famílies i els resums, amb fotografies, de les festes i activitats que hem dut a terme des de l'AFA.</p>
    
    <div class="grid gap-6">
      {sortedPosts.map((post) => (
        <article class="bg-white p-6 rounded-xl shadow-sm border border-slate-100 flex flex-col md:flex-row gap-6 hover:shadow-md transition">
          {post.frontmatter.image && (
            <div class="w-full md:w-48 h-48 md:h-auto shrink-0 bg-slate-100 rounded-lg overflow-hidden">
              <img src={post.frontmatter.image} alt="" class="w-full h-full object-cover" />
            </div>
          )}
          <div class="flex-grow flex flex-col justify-center">
            <div class="flex gap-3 items-center mb-2">
              <span class="text-sm text-brand-light font-bold">
                {post.frontmatter.tipus || 'Actualitat'}
              </span>
              <span class="text-sm text-slate-400 font-medium">
                • {new Date(post.frontmatter.date).toLocaleDateString('ca-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            </div>
            <h2 class="text-2xl font-bold mb-3 text-slate-800">
              <a href={post.url || `/actualitat/${post.file.split('/').pop().replace('.md', '')}`} class="hover:text-brand-blue transition">
                {post.frontmatter.title}
              </a>
            </h2>
            <div class="text-slate-600 line-clamp-3">
              Llegeix l'article complet per saber-ne més detalls sobre aquesta actualització de l'AFA.
            </div>
            <div class="mt-4">
              <a href={post.url || `/actualitat/${post.file.split('/').pop().replace('.md', '')}`} class="text-brand-blue font-medium hover:underline">Obrir publicació &rarr;</a>
            </div>
          </div>
        </article>
      ))}
      
      {sortedPosts.length === 0 && (
        <div class="text-center py-12 bg-slate-50 rounded-lg text-slate-500">
          Encara no hi ha cap publicació.
        </div>
      )}
    </div>
  </div>
</Layout>
