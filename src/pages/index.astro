---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inici">
  <!-- Bàner d'Avisos -->
  <div class="bg-brand-accent text-white text-center py-2 px-4 text-sm font-medium">
    📢 Avís: Ja estan obertes les inscripcions per a les extraescolars del curs vinent! <a href="/serveis/extraescolars" class="underline hover:text-blue-900">Inscriu-t'hi aquí</a>.
  </div>

  <!-- Hero Section -->
  <section class="bg-brand-light/10 py-16">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-brand-blue mb-6">Benvinguts a l'AFA Casa Nostra</h1>
      <p class="text-xl text-slate-600 mb-8 max-w-2xl mx-auto">Treballem junts per millorar el dia a dia de l'escola i oferir els millors serveis als nostres fills i filles.</p>
      
      <!-- Accessos Directes Ràpids -->
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contacte" class="bg-brand-blue hover:bg-brand-blue/90 text-white font-medium py-3 px-6 rounded-lg shadow transition flex items-center gap-2">
          👤 Fes-te Soci/a
        </a>
        <a href="/serveis/llibres" class="bg-white hover:bg-slate-50 text-brand-blue border border-slate-200 font-medium py-3 px-6 rounded-lg shadow transition flex items-center gap-2">
          📚 Llibres de Text
        </a>
        <a href="/festes" class="bg-white hover:bg-slate-50 text-brand-blue border border-slate-200 font-medium py-3 px-6 rounded-lg shadow transition flex items-center gap-2">
          🎉 Esdeveniments
        </a>
      </div>
    </div>
  </section>

  <!-- Calendari i Agenda -->
  <section class="py-16 max-w-6xl mx-auto px-4 border-b border-slate-100">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold text-brand-blue">Agenda Propera</h2>
      <a href="/festes" class="text-brand-light font-medium hover:underline hidden sm:block">Veure tot el calendari &rarr;</a>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="flex bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden hover:shadow-md transition">
        <div class="bg-brand-blue text-white p-6 flex flex-col justify-center items-center min-w-[100px]">
          <span class="text-3xl font-bold">15</span>
          <span class="uppercase text-sm tracking-wider">Oct</span>
        </div>
        <div class="p-6">
          <h3 class="font-bold text-lg mb-1">Assemblea General Ordinària</h3>
          <p class="text-slate-600 text-sm">Sala d'actes de l'escola a les 19:00h.</p>
        </div>
      </div>
      <div class="flex bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden hover:shadow-md transition">
        <div class="bg-brand-accent text-white p-6 flex flex-col justify-center items-center min-w-[100px]">
          <span class="text-3xl font-bold">31</span>
          <span class="uppercase text-sm tracking-wider">Oct</span>
        </div>
        <div class="p-6">
          <h3 class="font-bold text-lg mb-1">Festa de la Castanyada</h3>
          <p class="text-slate-600 text-sm">Venda de castanyes i activitats al pati a partir de les 16:30h.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Serveis Principals -->
  <section class="py-16 max-w-6xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-center text-brand-blue mb-10">Serveis Principals</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Card Menjador -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 hover:shadow-md transition">
        <div class="w-12 h-12 bg-orange-100 text-orange-600 rounded-lg flex items-center justify-center mb-4 text-2xl">
          🍽️
        </div>
        <h3 class="text-xl font-bold mb-2">Menjador i Espai Migdia</h3>
        <p class="text-slate-600 mb-4">Consulta el menú mensual, la normativa i la informació de l'empresa gestora.</p>
        <a href="/serveis/menjador" class="text-brand-light font-medium hover:underline">Més informació &rarr;</a>
      </div>

      <!-- Card Extraescolars -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 hover:shadow-md transition">
        <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center mb-4 text-2xl">
          ⚽
        </div>
        <h3 class="text-xl font-bold mb-2">Extraescolars</h3>
        <p class="text-slate-600 mb-4">Catàleg d'activitats per curs, horaris i formularis d'inscripció.</p>
        <a href="/serveis/extraescolars" class="text-brand-light font-medium hover:underline">Més informació &rarr;</a>
      </div>

      <!-- Card Botiga -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 hover:shadow-md transition">
        <div class="w-12 h-12 bg-green-100 text-green-600 rounded-lg flex items-center justify-center mb-4 text-2xl">
          🛍️
        </div>
        <h3 class="text-xl font-bold mb-2">Botiga i Pagaments</h3>
        <p class="text-slate-600 mb-4">Adquisició de llibres, tiquets de festes o material de forma segura i ràpida.</p>
        <a href="/botiga" class="text-brand-light font-medium hover:underline">Accedir a la botiga &rarr;</a>
      </div>

    </div>
  </section>
</Layout>
