---
import Layout from '../layouts/Layout.astro';

// Obtenir els esdeveniments de l'agenda des del CMS
const allEvents = Object.values(import.meta.glob('../content/agenda/*.md', { eager: true })) as any[];

// Ordenar per data cronològica
const sortedEvents = allEvents.sort((a, b) => new Date(a.frontmatter.date).valueOf() - new Date(b.frontmatter.date).valueOf());

// Filtrar per esdeveniments futurs o d'avui
const today = new Date();
today.setHours(0, 0, 0, 0);

const upcomingEvents = sortedEvents.filter(e => {
  const eventDate = new Date(e.frontmatter.date);
  return eventDate >= today;
});

// Mostrem fins a 4 esdeveniments propers (o els més recents si no n'hi ha de futurs)
const displayEvents = upcomingEvents.length > 0 
  ? upcomingEvents.slice(0, 4) 
  : sortedEvents.slice(0, 2);

function formatEventDate(dateString: string) {
  const d = new Date(dateString);
  const day = d.getDate();
  const rawMonth = d.toLocaleDateString('ca-ES', { month: 'short' }).replace('.', '').trim();
  const month = rawMonth.charAt(0).toUpperCase() + rawMonth.slice(1);
  return { day, month };
}
---

<Layout title="Inici">
  <!-- Bàner d'Avisos (Amagat temporalment perquè l'AFA no gestiona extraescolars)
  <div class="bg-brand-accent text-white text-center py-2 px-4 text-sm font-medium">
    📢 Avís: Ja estan obertes les inscripcions per a les extraescolars del curs vinent! <a href="/serveis/extraescolars" class="underline hover:text-blue-900">Inscriu-t'hi aquí</a>.
  </div>
  -->

  <!-- Hero Section -->
  <section class="bg-brand-light/10 py-16">
    <div class="max-w-6xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-brand-blue mb-6">Benvinguts a l'AFA Casa Nostra</h1>
      <p class="text-xl text-slate-600 mb-8 max-w-2xl mx-auto">Treballem junts per millorar el dia a dia de l'escola i oferir els millors serveis als nostres fills i filles.</p>
      
      <!-- Accessos Directes Ràpids -->
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contacte" class="bg-brand-blue hover:bg-brand-blue/90 text-white font-medium py-3 px-6 rounded-lg shadow transition flex items-center gap-2">
          👤 Fes-te Soci/a
        </a>
        <a href="/serveis/llibres" class="bg-white hover:bg-slate-50 text-brand-blue border border-slate-200 font-medium py-3 px-6 rounded-lg shadow transition flex items-center gap-2">
          📚 Llibres de Text
        </a>
        <a href="/festes" class="bg-white hover:bg-slate-50 text-brand-blue border border-slate-200 font-medium py-3 px-6 rounded-lg shadow transition flex items-center gap-2">
          🎉 Esdeveniments
        </a>
      </div>
    </div>
  </section>

  <!-- Calendari i Agenda -->
  <section class="py-16 max-w-6xl mx-auto px-4 border-b border-slate-100">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-3xl font-bold text-brand-blue">Agenda Propera</h2>
      <a href="/festes" class="text-brand-light font-medium hover:underline hidden sm:block">Veure festes i esdeveniments &rarr;</a>
    </div>
    
    {displayEvents.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {displayEvents.map((event, index) => {
          const { day, month } = formatEventDate(event.frontmatter.date);
          const isEven = index % 2 === 0;
          return (
            <div class="flex bg-white rounded-xl shadow-sm border border-slate-100 overflow-hidden hover:shadow-md transition">
              <div class={`${isEven ? 'bg-brand-blue' : 'bg-brand-accent'} text-white p-6 flex flex-col justify-center items-center min-w-[100px]`}>
                <span class="text-3xl font-bold">{day}</span>
                <span class="uppercase text-sm tracking-wider font-semibold">{month}</span>
              </div>
              <div class="p-6 flex flex-col justify-center">
                <h3 class="font-bold text-lg mb-1 text-slate-800">{event.frontmatter.title}</h3>
                {event.frontmatter.lloc && (
                  <p class="text-slate-600 text-sm font-medium mb-1">{event.frontmatter.lloc}</p>
                )}
                {event.frontmatter.description && (
                  <p class="text-slate-500 text-sm leading-relaxed">{event.frontmatter.description}</p>
                )}
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <div class="bg-slate-50 border border-slate-200 rounded-xl p-8 text-center text-slate-500">
        <p>No hi ha esdeveniments programats a l'agenda en aquests moments.</p>
      </div>
    )}
  </section>

  <!-- Serveis Principals -->
  <section class="py-16 max-w-6xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-center text-brand-blue mb-10">Serveis Principals</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Card Llibres de Text -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 hover:shadow-md transition">
        <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-lg flex items-center justify-center mb-4 text-2xl">
          📚
        </div>
        <h3 class="text-xl font-bold mb-2">Socialització de Llibres</h3>
        <p class="text-slate-600 mb-4">Projecte de reutilització i comanda de llibres de text per a tots els cursos.</p>
        <a href="/serveis/llibres" class="text-brand-light font-medium hover:underline">Més informació &rarr;</a>
      </div>

      <!-- Card Tallers Famílies -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 hover:shadow-md transition">
        <div class="w-12 h-12 bg-purple-100 text-purple-600 rounded-lg flex items-center justify-center mb-4 text-2xl">
          🎨
        </div>
        <h3 class="text-xl font-bold mb-2">Tallers i Famílies</h3>
        <p class="text-slate-600 mb-4">Xerrades, activitats de formació i trobades familiars durant el curs escolar.</p>
        <a href="/serveis/tallers" class="text-brand-light font-medium hover:underline">Més informació &rarr;</a>
      </div>

      <!-- Card Botiga -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 hover:shadow-md transition">
        <div class="w-12 h-12 bg-green-100 text-green-600 rounded-lg flex items-center justify-center mb-4 text-2xl">
          🛍️
        </div>
        <h3 class="text-xl font-bold mb-2">Botiga i Pagaments</h3>
        <p class="text-slate-600 mb-4">Inscripcions a festes, quotes de soci i pagament segur amb targeta.</p>
        <a href="/botiga" class="text-brand-light font-medium hover:underline">Accedir a la botiga &rarr;</a>
      </div>

      <!-- Amagats temporalment (l'AFA no gestiona menjador ni extraescolars actualment):
      <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 hover:shadow-md transition">
        <div class="w-12 h-12 bg-orange-100 text-orange-600 rounded-lg flex items-center justify-center mb-4 text-2xl">
          🍽️
        </div>
        <h3 class="text-xl font-bold mb-2">Menjador i Espai Migdia</h3>
        <p class="text-slate-600 mb-4">Consulta el menú mensual, la normativa i la informació de l'empresa gestora.</p>
        <a href="/serveis/menjador" class="text-brand-light font-medium hover:underline">Més informació &rarr;</a>
      </div>

      <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6 hover:shadow-md transition">
        <div class="w-12 h-12 bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center mb-4 text-2xl">
          ⚽
        </div>
        <h3 class="text-xl font-bold mb-2">Extraescolars</h3>
        <p class="text-slate-600 mb-4">Catàleg d'activitats per curs, horaris i formularis d'inscripció.</p>
        <a href="/serveis/extraescolars" class="text-brand-light font-medium hover:underline">Més informació &rarr;</a>
      </div>
      -->

    </div>
  </section>
</Layout>
