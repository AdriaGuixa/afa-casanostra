---
import Layout from '../layouts/Layout.astro';
---

<Layout title="El Meu Carnet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html-to-image/1.11.11/html-to-image.min.js" is:inline></script>
  <!-- Nova llibreria per generar el QR directament al navegador (Molt més ràpid i fiable) -->
  <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js" is:inline></script>

  <div class="min-h-[80vh] flex flex-col items-center justify-center px-4 bg-slate-50 py-12">
    
    <div id="login-section" class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 max-w-md w-full">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-brand-blue mb-2">El teu Carnet Digital</h1>
        <p class="text-slate-600">Introdueix les teves dades per generar i descarregar el teu carnet de l'AFA.</p>
      </div>

      <form id="carnet-form" class="space-y-5">
        <div>
          <label for="dni" class="block text-sm font-medium text-slate-700 mb-1">DNI (amb lletra)</label>
          <input type="text" id="dni" required class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-light focus:border-brand-light outline-none" placeholder="Ex: 12345678A" />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Correu electrònic</label>
          <input type="email" id="email" required class="w-full px-4 py-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-light focus:border-brand-light outline-none" placeholder="correu@exemple.com" />
        </div>
        <button type="submit" id="submit-btn" class="w-full bg-brand-blue text-white font-bold py-3 px-4 rounded-lg hover:bg-brand-blue/90 transition shadow-sm flex justify-center items-center gap-2">
          <span>Generar Carnet</span>
        </button>
        <p id="error-msg" class="text-red-500 text-sm text-center hidden mt-2"></p>
      </form>
    </div>

    <div id="result-section" class="hidden flex-col items-center max-w-sm w-full">
      
      <div id="carnet-card" class="bg-white rounded-2xl shadow-xl overflow-hidden w-full relative border border-slate-200">
        <div class="bg-brand-blue p-6 text-white text-center flex flex-col items-center">
          <div class="bg-white py-2 px-4 rounded-xl mb-4 shadow-sm inline-block">
            <img src="/images/logo-afa.png" alt="AFA Logo" class="h-8" />
          </div>
          <h2 class="text-xl font-bold tracking-widest uppercase">Carnet de l'AFA</h2>
          <p class="text-blue-200 text-sm mt-1">Curs 2025-2026</p>
        </div>
        
        <div class="p-6 bg-white flex flex-col items-center">
          <!-- Utilitzem un CANVAS pur perquè Safari no ho bloquegi en descarregar -->
          <div id="qr-container" class="bg-white p-2 rounded-xl border-2 border-slate-100 shadow-sm mb-6 flex justify-center items-center" style="width: 200px; height: 200px;">
            <canvas id="qr-canvas"></canvas>
          </div>
          
          <div class="w-full text-center">
            <p class="text-xs text-slate-400 uppercase font-bold tracking-wider mb-2">Família Autoritzada</p>
            <ul id="card-names" class="text-lg font-bold text-brand-blue mb-4 leading-tight">
            </ul>
            <div class="bg-slate-50 border border-slate-100 py-2 px-4 rounded-lg inline-block">
              <span class="text-xs text-slate-500 uppercase">Codi: </span>
              <span id="card-id" class="font-mono font-bold text-slate-700"></span>
            </div>
          </div>
        </div>
        
        <div class="bg-brand-light/10 text-center py-3 text-xs text-brand-blue font-medium">
          Vàlid per a descomptes i festes AFA
        </div>
      </div>

      <div class="mt-8 w-full space-y-4 text-center">
        
        <button id="download-btn" class="w-full bg-green-600 text-white font-bold py-3 px-4 rounded-lg hover:bg-green-700 transition shadow-lg flex justify-center items-center gap-2">
          <span class="text-xl">⬇️</span>
          <span>Descarregar Imatge</span>
        </button>

        <div class="text-slate-500 text-xs mt-2">
          O fes una captura de pantalla normal del telèfon.
        </div>

        <button onclick="window.location.reload()" class="text-brand-light font-medium hover:underline text-sm mt-4">
          Tornar enrere
        </button>
      </div>

    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const form = document.getElementById('carnet-form');
      const submitBtn = document.getElementById('submit-btn');
      const errorMsg = document.getElementById('error-msg');
      
      const loginSection = document.getElementById('login-section');
      const resultSection = document.getElementById('result-section');
      
      const qrCanvas = document.getElementById('qr-canvas');
      const cardNames = document.getElementById('card-names');
      const cardId = document.getElementById('card-id');
      const downloadBtn = document.getElementById('download-btn');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const dni = document.getElementById('dni').value;
        const email = document.getElementById('email').value;
        
        errorMsg.classList.add('hidden');
        submitBtn.innerHTML = 'Generant...';
        submitBtn.disabled = true;

        try {
          const response = await fetch(`/.netlify/functions/descarregar-carnet?dni=${encodeURIComponent(dni)}&email=${encodeURIComponent(email)}`);
          const data = await response.json();
          
          if (response.ok && data.valid) {
            
            const validationUrl = `${window.location.origin}/validar?id=${encodeURIComponent(data.codi)}`;
            
            // Generem el QR localment dins del Canvas
            QRCode.toCanvas(qrCanvas, validationUrl, {
              width: 180,
              margin: 1,
              color: {
                dark: '#000000',
                light: '#ffffff'
              }
            }, function (error) {
              if (error) console.error("Error generant QR:", error);
              
              cardId.textContent = data.codi;
              cardNames.innerHTML = data.titulars.map(nom => `<li>${nom}</li>`).join('');
              
              loginSection.classList.add('hidden');
              resultSection.classList.remove('hidden');
              resultSection.classList.add('flex');
            });
            
          } else {
            errorMsg.textContent = data.error || "Dades incorrectes. Revisa el teu DNI i Correu.";
            errorMsg.classList.remove('hidden');
          }
        } catch (error) {
          console.error('Error:', error);
          errorMsg.textContent = "Error de connexió. Torna-ho a provar més tard.";
          errorMsg.classList.remove('hidden');
        } finally {
          submitBtn.innerHTML = 'Generar Carnet';
          submitBtn.disabled = false;
        }
      });

      downloadBtn.addEventListener('click', () => {
        const cardElement = document.getElementById('carnet-card');
        const originalText = downloadBtn.innerHTML;
        
        downloadBtn.innerHTML = 'Processant Imatge...';
        downloadBtn.disabled = true;

        window.htmlToImage.toPng(cardElement, { pixelRatio: 3, backgroundColor: '#ffffff' })
          .then(function (dataUrl) {
            const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;

            if (isIOS) {
               const img = new Image();
               img.src = dataUrl;
               img.style.width = '100%';
               img.style.borderRadius = '1rem';
               img.style.boxShadow = '0 10px 25px -5px rgba(0, 0, 0, 0.1)';
               
               cardElement.innerHTML = '';
               cardElement.appendChild(img);
               
               downloadBtn.innerHTML = '✓ Imatge llista. Mantén-la premuda per Desar-la al rodet.';
               downloadBtn.classList.replace('bg-green-600', 'bg-blue-600');
            } else {
               const link = document.createElement('a');
               link.download = `Carnet-AFA-${cardId.textContent}.png`;
               link.href = dataUrl;
               link.click();
               
               downloadBtn.innerHTML = '✓ Descarregat!';
               setTimeout(() => {
                  downloadBtn.innerHTML = originalText;
                  downloadBtn.disabled = false;
               }, 3000);
            }
          })
          .catch(function (error) {
            console.error('Error html-to-image:', error);
            alert("S'ha produït un error al generar la imatge. Si us plau, fes una captura de pantalla normal.");
            downloadBtn.innerHTML = originalText;
            downloadBtn.disabled = false;
          });
      });
    });
  </script>
</Layout>
