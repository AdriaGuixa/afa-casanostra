---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Botiga de l'AFA">
  <div class="max-w-4xl mx-auto px-4 py-16 text-center">
    <div class="w-20 h-20 bg-green-100 text-green-600 rounded-full flex items-center justify-center mx-auto mb-6 text-4xl">
      🛍️
    </div>
    <h1 class="text-4xl font-bold text-brand-blue mb-4">La Botiga de l'AFA</h1>
    <p class="text-xl text-slate-600 mb-8 max-w-2xl mx-auto">Ben aviat podreu adquirir els tiquets per a dinars de germanor, pagar la quota de la disfressa de Carnestoltes o altres activitats directament des d'aquí de forma segura.</p>
    
    <div class="bg-white p-8 rounded-xl shadow-sm border border-slate-100 max-w-md mx-auto text-left">
      <h3 class="font-bold text-lg mb-4 text-center">Serveis Pròxims</h3>
      <ul class="space-y-3">
        <li class="flex items-center gap-2 text-slate-600">
          <span class="text-green-500">✓</span> Pagaments amb Targeta (Stripe)
        </li>
        <li class="flex items-center gap-2 text-slate-600">
          <span class="text-green-500">✓</span> Pagament àgil de Tiquets Festes
        </li>
        <li class="flex items-center gap-2 text-slate-600">
          <span class="text-green-500">✓</span> Adquisició de materials
        </li>
      </ul>
      <div class="mt-8 text-center text-sm text-slate-400">
        Pàgina en construcció. Mòdul de pagaments virtuals en preparació.
      </div>
    </div>
  </div>
</Layout>
