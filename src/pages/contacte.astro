---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacte">
  <div class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-2 gap-12">
    
    <div>
      <h1 class="text-4xl font-bold text-brand-blue mb-6">Contacta amb nosaltres</h1>
      <p class="text-lg text-slate-600 mb-8">Tens algun dubte, suggeriment o vols col·laborar amb l'AFA? Emplena el formulari i et respondrem tan aviat com ens sigui possible.</p>
      
      <div class="space-y-6">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-light/20 flex items-center justify-center text-brand-blue shrink-0">
            ✉️
          </div>
          <div>
            <h3 class="font-bold text-lg">Correu Electrònic Oficial</h3>
            <p class="text-slate-600">ampa.escolacasanostra@gmail.com</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-light/20 flex items-center justify-center text-brand-blue shrink-0">
            📍
          </div>
          <div>
            <h3 class="font-bold text-lg">Bústia Física</h3>
            <p class="text-slate-600">Podeu deixar les vostres comunicacions físiques a la bústia de l'AFA situada a la secretaria de l'Escola.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-light/20 flex items-center justify-center text-brand-blue shrink-0">
            ❓
          </div>
          <div>
            <h3 class="font-bold text-lg">Preguntes Freqüents</h3>
            <p class="text-slate-600">Abans d'escriure'ns, potser la teva resposta ja es troba a la secció de <a href="/pmf" class="text-brand-light hover:underline font-medium">PMF (Preguntes Més Freqüents)</a>.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Formulari de Contacte -->
    <div class="bg-white p-8 rounded-xl shadow-sm border border-slate-100">
      
      <!-- Missatges d'estat -->
      <div id="contact-success" class="hidden bg-green-50 border border-green-200 text-green-800 rounded-lg p-5 mb-6 text-sm">
        <div class="flex items-center gap-2 font-bold text-base mb-1">
          <span>✓</span> Missatge enviat amb èxit!
        </div>
        <p>Gràcies per posar-te en contacte amb l'AFA. T'hem enviat un correu de confirmació i et respondrem tan aviat com ens sigui possible.</p>
      </div>

      <div id="contact-error" class="hidden bg-red-50 border border-red-200 text-red-700 rounded-lg p-4 mb-6 text-sm">
        <span class="font-bold">Error:</span> <span id="contact-error-msg">No s'ha pogut enviar el missatge. Torna-ho a provar.</span>
      </div>

      <form id="contact-form" class="space-y-5">
        <div>
          <label for="nom" class="block text-sm font-medium text-slate-700 mb-1">Nom i Cognoms <span class="text-red-500">*</span></label>
          <input type="text" id="nom" name="nom" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-light focus:border-brand-light outline-none" placeholder="El teu nom" />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Correu Electrònic <span class="text-red-500">*</span></label>
          <input type="email" id="email" name="email" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-light focus:border-brand-light outline-none" placeholder="el-teu-correu@exemple.com" />
        </div>
        <div>
          <label for="comissio" class="block text-sm font-medium text-slate-700 mb-1">A quina comissió t'adreces?</label>
          <select id="comissio" name="comissio" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-light focus:border-brand-light outline-none bg-white">
            <option value="general">Consulta General / Junta</option>
            <option value="festes">Comissió de Festes</option>
            <option value="llibres">Comissió de Socialització de Llibres</option>
          </select>
        </div>
        <div>
          <label for="missatge" class="block text-sm font-medium text-slate-700 mb-1">Missatge o Suggeriment <span class="text-red-500">*</span></label>
          <textarea id="missatge" name="missatge" rows="4" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-light focus:border-brand-light outline-none" placeholder="Com et podem ajudar?"></textarea>
        </div>

        <div>
          <label class="flex items-start gap-3 cursor-pointer group">
            <div class="flex-shrink-0 mt-1">
              <input type="checkbox" id="accepta_privacitat" name="accepta_privacitat" required class="w-4 h-4 rounded border-slate-300 text-brand-blue focus:ring-brand-light transition" />
            </div>
            <span class="text-xs text-slate-500 leading-relaxed">
              He llegit i accepto la <a href="/politica-privacitat" target="_blank" class="text-brand-blue underline hover:text-brand-dark">Política de Privacitat</a> de l'AFA per a la gestió d'aquesta consulta. <span class="text-red-500">*</span>
            </span>
          </label>
        </div>

        <button type="submit" id="btn-submit" class="w-full bg-brand-blue text-white font-bold py-3 px-4 rounded-lg hover:bg-brand-blue/90 transition shadow-sm cursor-pointer flex justify-center items-center gap-2">
          <span>Enviar Missatge</span>
        </button>
      </form>
    </div>

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement | null;
      const successBox = document.getElementById('contact-success');
      const errorBox = document.getElementById('contact-error');
      const errorMsg = document.getElementById('contact-error-msg');

      if (!form || !btnSubmit) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Netejar missatges previs
        if (successBox) successBox.classList.add('hidden');
        if (errorBox) errorBox.classList.add('hidden');

        const nom = (document.getElementById('nom') as HTMLInputElement)?.value;
        const email = (document.getElementById('email') as HTMLInputElement)?.value;
        const comissio = (document.getElementById('comissio') as HTMLSelectElement)?.value;
        const missatge = (document.getElementById('missatge') as HTMLTextAreaElement)?.value;

        btnSubmit.disabled = true;
        const originalText = btnSubmit.innerHTML;
        btnSubmit.innerHTML = '<span>Enviant missatge...</span>';

        try {
          const response = await fetch('/.netlify/functions/enviar-contacte', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ nom, email, comissio, missatge })
          });

          const result = await response.json();

          if (response.ok && result.success) {
            form.reset();
            if (successBox) {
              successBox.classList.remove('hidden');
              successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
          } else {
            throw new Error(result.error || 'No s\'ha pogut enviar el missatge.');
          }
        } catch (err: any) {
          if (errorBox && errorMsg) {
            errorMsg.textContent = err.message || 'S\'ha produït un error en connectar amb el servidor.';
            errorBox.classList.remove('hidden');
          }
        } finally {
          btnSubmit.disabled = false;
          btnSubmit.innerHTML = originalText;
        }
      });
    });
  </script>
</Layout>
