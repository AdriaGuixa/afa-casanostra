---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacte">
  <div class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-2 gap-12">
    
    <div>
      <h1 class="text-4xl font-bold text-brand-blue mb-6">Contacta amb nosaltres</h1>
      <p class="text-lg text-slate-600 mb-8">Tens algun dubte, suggeriment o vols col·laborar amb l'AFA? Emplena el formulari i et respondrem tan aviat com ens sigui possible.</p>
      
      <div class="space-y-6">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-light/20 flex items-center justify-center text-brand-blue shrink-0">
            ✉️
          </div>
          <div>
            <h3 class="font-bold text-lg">Correu Electrònic Oficial</h3>
            <p class="text-slate-600">ampa.escolacasanostra@gmail.com</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-light/20 flex items-center justify-center text-brand-blue shrink-0">
            📍
          </div>
          <div>
            <h3 class="font-bold text-lg">Bústia Física</h3>
            <p class="text-slate-600">Podeu deixar les vostres comunicacions físiques a la bústia de l'AFA situada a la secretaria de l'Escola.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-full bg-brand-light/20 flex items-center justify-center text-brand-blue shrink-0">
            ❓
          </div>
          <div>
            <h3 class="font-bold text-lg">Preguntes Freqüents</h3>
            <p class="text-slate-600">Abans d'escriure'ns, potser la teva resposta ja es troba a la secció de <a href="/pmf" class="text-brand-light hover:underline font-medium">PMF (Preguntes Més Freqüents)</a>.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Formulari de Contacte -->
    <div class="bg-white p-8 rounded-xl shadow-sm border border-slate-100">
      <form class="space-y-5" onsubmit="event.preventDefault(); alert('Gràcies per contactar amb l\'AFA. Ens posarem en contacte aviat!');">
        <div>
          <label for="nom" class="block text-sm font-medium text-slate-700 mb-1">Nom i Cognoms</label>
          <input type="text" id="nom" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-light focus:border-brand-light outline-none" />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Correu Electrònic</label>
          <input type="email" id="email" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-light focus:border-brand-light outline-none" />
        </div>
        <div>
          <label for="comissio" class="block text-sm font-medium text-slate-700 mb-1">A quina comissió t'adreces?</label>
          <select id="comissio" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-light focus:border-brand-light outline-none bg-white">
            <option value="general">Consulta General / Junta</option>
            <option value="menjador">Comissió de Menjador</option>
            <option value="extraescolars">Comissió d'Extraescolars</option>
            <option value="festes">Comissió de Festes</option>
          </select>
        </div>
        <div>
          <label for="missatge" class="block text-sm font-medium text-slate-700 mb-1">Missatge o Suggeriment</label>
          <textarea id="missatge" rows="4" required class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-brand-light focus:border-brand-light outline-none"></textarea>
        </div>
        <button type="submit" class="w-full bg-brand-blue text-white font-bold py-3 px-4 rounded-lg hover:bg-brand-blue/90 transition shadow-sm">
          Enviar Missatge
        </button>
      </form>
    </div>

  </div>
</Layout>
