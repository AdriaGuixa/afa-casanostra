---
import Layout from '../layouts/Layout.astro';

const allDocs = Object.values(import.meta.glob('../content/documents/*.md', { eager: true })) as any[];

// Categories d'accés públic (es renderitzen a l'HTML públic durant el build)
const publicCategories = [
  {
    id: "Estatuts i RRI",
    title: "Estatuts i Reglament Intern",
    icon: "📜",
    desc: "Els documents fundacionals i de règim intern que marquen el funcionament de l'AFA."
  },
  {
    id: "Formularis",
    title: "Formularis i Autoritzacions",
    icon: "📝",
    desc: "Descàrrega de documents per a tràmits comuns com ordres SEPA, inscripcions o cobraments."
  }
];

// Categories d'accés exclusiu per a socis (es carreguen des del servidor un cop verificat l'accés)
const privateCategories = [
  {
    id: "Actes d'Assemblea",
    title: "Actes d'Assemblees",
    icon: "🗂️",
    desc: "Acords presos i resums oficials de les assemblees generals ordinàries i extraordinàries."
  },
  {
    id: "Informació Econòmica",
    title: "Informació Econòmica",
    icon: "📊",
    desc: "Consulta dels pressupostos anuals aprovats, balanços de comissions i estat de comptes."
  },
  {
    id: "Altres",
    title: "Altres Documents",
    icon: "📁",
    desc: "Circulars institucionals, convenis i altres arxius d'interès per a la comunitat educativa."
  }
];

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  const d = new Date(dateStr);
  return d.toLocaleDateString('ca-ES', { month: 'long', year: 'numeric' });
}
---

<Layout title="Transparència i Documents">
  <div class="max-w-5xl mx-auto px-4 py-12">
    
    <div class="mb-10">
      <h1 class="text-4xl font-extrabold text-brand-blue mb-4">Transparència i Documents Oficials</h1>
      <p class="text-lg text-slate-600 leading-relaxed max-w-3xl">
        A l'AFA Casa Nostra apostem per la màxima transparència. Els estatuts i formularis de l'associació són de consulta pública, mentre que les actes de les assemblees i els balanços econòmics són d'accés exclusiu per a les famílies sòcies.
      </p>
    </div>

    <!-- 1. SECCIÓ PÚBLICA: ESTATUTS I FORMULARIS -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      {publicCategories.map((cat) => {
        const docsInCat = allDocs
          .filter((doc) => doc.frontmatter.tipus === cat.id)
          .sort((a, b) => new Date(b.frontmatter.date || 0).valueOf() - new Date(a.frontmatter.date || 0).valueOf());

        return (
          <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-3 mb-3">
                <span class="text-3xl shrink-0 p-2.5 bg-slate-50 border border-slate-100 rounded-xl">{cat.icon}</span>
                <div>
                  <div class="flex items-center gap-2 flex-wrap">
                    <h2 class="text-xl font-bold text-slate-800">{cat.title}</h2>
                    <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-green-100 text-green-800">
                      Accés públic
                    </span>
                  </div>
                  <span class="text-xs font-semibold text-slate-400">
                    {docsInCat.length} {docsInCat.length === 1 ? 'document' : 'documents'}
                  </span>
                </div>
              </div>
              <p class="text-sm text-slate-500 mb-6 leading-relaxed">
                {cat.desc}
              </p>

              {docsInCat.length > 0 ? (
                <div class="space-y-3">
                  {docsInCat.map((doc) => (
                    <div class="p-3.5 rounded-xl border border-slate-100 bg-slate-50/70 hover:bg-slate-50 transition flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                      <div class="flex-grow">
                        <h3 class="font-bold text-slate-800 text-sm">{doc.frontmatter.title}</h3>
                        {doc.frontmatter.description && (
                          <p class="text-xs text-slate-500 mt-0.5 leading-snug">{doc.frontmatter.description}</p>
                        )}
                        {doc.frontmatter.date && (
                          <span class="text-[11px] text-slate-400 font-medium capitalize block mt-1">
                            🗓️ {formatDate(doc.frontmatter.date)}
                          </span>
                        )}
                      </div>

                      {doc.frontmatter.file ? (
                        <a 
                          href={doc.frontmatter.file} 
                          target="_blank" 
                          download
                          class="shrink-0 inline-flex items-center gap-1.5 bg-brand-blue text-white font-semibold px-3.5 py-1.5 rounded-lg hover:bg-brand-blue/90 transition text-xs shadow-sm self-start sm:self-center"
                        >
                          <span>⬇️</span> PDF
                        </a>
                      ) : (
                        <span class="text-xs text-slate-400 italic">Properament</span>
                      )}
                    </div>
                  ))}
                </div>
              ) : (
                <div class="p-4 rounded-xl border border-dashed border-slate-200 text-center text-slate-400 text-xs italic">
                  Encara no s'ha pujat cap document en aquesta secció.
                </div>
              )}
            </div>

            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
              <span>Gestió documental AFA</span>
              <span>Format PDF</span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- 2. SECCIÓ PRIVADA PER A SOCIS -->
    <div id="private-docs-section">
      
      <!-- Pantalla de càrrega quan es comprova la sessió guardada -->
      <div id="session-loading" class="hidden bg-white rounded-2xl shadow-sm border border-slate-200 p-10 text-center">
        <p class="text-slate-500 font-medium">Verificant l'accés de soci...</p>
      </div>

      <!-- Pantalla de bloqueig / Login OTP per a Socis -->
      <div id="private-docs-gate" class="bg-white rounded-2xl shadow-md border border-slate-200 overflow-hidden">
        <div class="bg-brand-blue/5 border-b border-slate-200 px-6 py-5 flex items-center justify-between flex-wrap gap-3">
          <div class="flex items-center gap-3">
            <span class="text-2xl">🔒</span>
            <div>
              <h2 class="text-lg font-bold text-brand-blue">Documentació Interna per a Socis</h2>
              <p class="text-xs text-slate-600">Actes d'Assemblees i Informació Econòmica</p>
            </div>
          </div>
          <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-brand-blue text-white">
            Accés restringit
          </span>
        </div>

        <div class="p-6 md:p-10 max-w-xl mx-auto">
          
          <!-- Pas 1: Introduir correu de soci -->
          <div id="step-email-container">
            <p class="text-slate-600 text-sm mb-6 leading-relaxed">
              Per consultar les actes i els balanços econòmics de l'AFA, introdueix el <strong>correu electrònic</strong> amb què la teva família consta inscrita com a sòcia. T'hi enviarem un codi temporal de 6 xifres per verificar l'accés.
            </p>

            <form id="form-send-code" class="space-y-4">
              <div>
                <label for="soci-email" class="block text-sm font-semibold text-slate-700 mb-1.5">
                  Correu electrònic de soci/a
                </label>
                <input
                  type="email"
                  id="soci-email"
                  required
                  placeholder="correu@exemple.com"
                  class="w-full px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-light focus:border-brand-light outline-none transition"
                />
              </div>

              <button
                type="submit"
                id="btn-send-code"
                class="w-full bg-brand-blue text-white font-bold py-3.5 px-6 rounded-xl hover:bg-brand-blue/90 transition shadow-sm cursor-pointer flex justify-center items-center gap-2"
              >
                <span>✉️</span>
                <span>Enviar codi d'accés al correu</span>
              </button>
            </form>
          </div>

          <!-- Pas 2: Introduir el codi de 6 xifres rebut al correu -->
          <div id="step-code-container" class="hidden">
            <div class="bg-green-50 border border-green-200 text-green-800 rounded-xl p-4 mb-6 text-sm">
              Hem enviat un codi de 6 xifres a <strong id="display-target-email"></strong>. Revisa la safata d'entrada (o la carpeta de correu brossa).
            </div>

            <form id="form-verify-code" class="space-y-4">
              <div>
                <label for="soci-otp-code" class="block text-sm font-semibold text-slate-700 mb-1.5">
                  Codi de verificació (6 xifres)
                </label>
                <input
                  type="text"
                  id="soci-otp-code"
                  inputmode="numeric"
                  pattern="[0-9]{6}"
                  maxlength="6"
                  required
                  placeholder="123456"
                  class="w-full px-4 py-3 text-center text-2xl font-mono font-bold tracking-[0.4em] border border-slate-300 rounded-xl focus:ring-2 focus:ring-brand-light focus:border-brand-light outline-none transition"
                />
              </div>

              <button
                type="submit"
                id="btn-verify-code"
                class="w-full bg-green-600 text-white font-bold py-3.5 px-6 rounded-xl hover:bg-green-700 transition shadow-sm cursor-pointer flex justify-center items-center gap-2"
              >
                <span>🔓</span>
                <span>Verificar i accedir als documents</span>
              </button>

              <div class="text-center pt-2">
                <button
                  type="button"
                  id="btn-back-email"
                  class="text-xs text-slate-500 hover:text-brand-blue underline cursor-pointer"
                >
                  &larr; Canviar de correu o sol·licitar un codi nou
                </button>
              </div>
            </form>
          </div>

          <!-- Missatge d'error -->
          <div id="auth-error-box" class="hidden mt-4 bg-red-50 border border-red-200 text-red-700 rounded-xl p-3.5 text-sm text-center font-medium"></div>
        </div>
      </div>

      <!-- Contingut Desbloquejat per a Socis -->
      <div id="private-docs-unlocked" class="hidden space-y-8">
        
        <!-- Barra d'estat del soci -->
        <div class="bg-brand-blue/5 border border-brand-blue/20 rounded-2xl p-4 px-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span class="text-2xl">✅</span>
            <div>
              <p class="text-sm font-bold text-brand-blue">
                Accés verificat: <span id="soci-family-name" class="font-extrabold"></span>
              </p>
              <p class="text-xs text-slate-500">
                Codi de soci: <span id="soci-code-badge" class="font-mono font-semibold"></span>
              </p>
            </div>
          </div>
          <button
            type="button"
            id="btn-logout-docs"
            class="text-xs font-semibold text-slate-600 hover:text-red-600 bg-white border border-slate-200 px-3.5 py-2 rounded-lg transition self-start sm:self-center cursor-pointer"
          >
            Tancar sessió
          </button>
        </div>

        <!-- Graella de Categories Privades -->
        <div id="private-categories-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8"></div>
      </div>

    </div>

    <!-- Avís de seguretat / RGPD -->
    <div class="mt-12 bg-blue-50/60 border border-blue-200/60 rounded-xl p-5 text-sm text-blue-900 flex items-start gap-3">
      <span class="text-xl">ℹ️</span>
      <p class="leading-relaxed">
        <strong>Protecció de Dades:</strong> Totes les actes d'assemblea i documents es troben prèviament revisats i anonimitzats pel que fa a dades personals de caràcter sensible per garantir el compliment del RGPD.
      </p>
    </div>

  </div>

  <script define:vars={{ privateCategories }}>
    document.addEventListener('DOMContentLoaded', () => {
      const STORAGE_KEY = 'afa_soci_docs_session';
      let currentChallengeToken = '';
      let currentEmail = '';

      const sessionLoading = document.getElementById('session-loading');
      const gateBox = document.getElementById('private-docs-gate');
      const unlockedBox = document.getElementById('private-docs-unlocked');
      const stepEmailContainer = document.getElementById('step-email-container');
      const stepCodeContainer = document.getElementById('step-code-container');

      const formSendCode = document.getElementById('form-send-code');
      const inputEmail = document.getElementById('soci-email');
      const btnSendCode = document.getElementById('btn-send-code');

      const formVerifyCode = document.getElementById('form-verify-code');
      const inputOtpCode = document.getElementById('soci-otp-code');
      const btnVerifyCode = document.getElementById('btn-verify-code');
      const btnBackEmail = document.getElementById('btn-back-email');
      const displayTargetEmail = document.getElementById('display-target-email');

      const errorBox = document.getElementById('auth-error-box');
      const sociFamilyName = document.getElementById('soci-family-name');
      const sociCodeBadge = document.getElementById('soci-code-badge');
      const btnLogout = document.getElementById('btn-logout-docs');
      const categoriesGrid = document.getElementById('private-categories-grid');

      function showError(msg) {
        if (!errorBox) return;
        errorBox.textContent = msg;
        errorBox.classList.remove('hidden');
      }

      function clearError() {
        if (!errorBox) return;
        errorBox.textContent = '';
        errorBox.classList.add('hidden');
      }

      function formatMonthYear(dateStr) {
        if (!dateStr) return '';
        const d = new Date(dateStr);
        if (isNaN(d.getTime())) return '';
        return d.toLocaleDateString('ca-ES', { month: 'long', year: 'numeric' });
      }

      function renderUnlockedDocuments(soci, documents, sessionToken) {
        if (gateBox) gateBox.classList.add('hidden');
        if (sessionLoading) sessionLoading.classList.add('hidden');
        if (unlockedBox) unlockedBox.classList.remove('hidden');

        if (sociFamilyName) {
          sociFamilyName.textContent =
            soci.titulars && soci.titulars.length > 0 ? soci.titulars.join(' i ') : soci.email;
        }
        if (sociCodeBadge) {
          sociCodeBadge.textContent = soci.codi || 'SOCI ACTIU';
        }

        if (!categoriesGrid) return;
        categoriesGrid.innerHTML = '';

        privateCategories.forEach((cat) => {
          const docsInCat = (documents || [])
            .filter((doc) => doc.tipus === cat.id)
            .sort((a, b) => new Date(b.date || 0).valueOf() - new Date(a.date || 0).valueOf());

          if (cat.id === 'Altres' && docsInCat.length === 0) return;

          const card = document.createElement('div');
          card.className = 'bg-white rounded-2xl shadow-sm border border-slate-200 p-6 md:p-8 flex flex-col justify-between';

          const countLabel = `${docsInCat.length} ${docsInCat.length === 1 ? 'document' : 'documents'}`;

          let docsListHtml = '';
          if (docsInCat.length > 0) {
            docsListHtml = `<div class="space-y-3">
              ${docsInCat
                .map((doc) => {
                  const formattedDate = formatMonthYear(doc.date);
                  return `
                    <div class="p-3.5 rounded-xl border border-slate-100 bg-slate-50/50 hover:bg-slate-50 transition flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                      <div class="flex-grow">
                        <h3 class="font-bold text-slate-800 text-sm">${doc.title}</h3>
                        ${doc.description ? `<p class="text-xs text-slate-500 mt-0.5 leading-snug">${doc.description}</p>` : ''}
                        ${formattedDate ? `<span class="text-[11px] text-slate-400 font-medium capitalize block mt-1">🗓️ ${formattedDate}</span>` : ''}
                      </div>
                      ${
                        doc.hasFile
                          ? `<button type="button" data-doc-id="${doc.id}" class="btn-download-private shrink-0 inline-flex items-center gap-1.5 bg-brand-blue text-white font-semibold px-3.5 py-1.5 rounded-lg hover:bg-brand-blue/90 transition text-xs shadow-sm self-start sm:self-center cursor-pointer">
                              <span>⬇️</span> PDF
                            </button>`
                          : `<span class="text-xs text-slate-400 italic">Properament</span>`
                      }
                    </div>
                  `;
                })
                .join('')}
            </div>`;
          } else {
            docsListHtml = `
              <div class="p-4 rounded-xl border border-dashed border-slate-200 text-center text-slate-400 text-xs italic">
                Encara no s'ha pujat cap document en aquesta secció.
              </div>
            `;
          }

          card.innerHTML = `
            <div>
              <div class="flex items-center gap-3 mb-3">
                <span class="text-3xl shrink-0 p-2.5 bg-slate-50 border border-slate-100 rounded-xl">${cat.icon}</span>
                <div>
                  <h2 class="text-xl font-bold text-slate-800">${cat.title}</h2>
                  <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">${countLabel}</span>
                </div>
              </div>
              <p class="text-sm text-slate-500 mb-6 leading-relaxed">${cat.desc}</p>
              ${docsListHtml}
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
              <span>Gestió documental AFA</span>
              <span>Format PDF</span>
            </div>
          `;

          categoriesGrid.appendChild(card);
        });

        // Vincular botons de descàrrega de PDFs privats
        const downloadBtns = categoriesGrid.querySelectorAll('.btn-download-private');
        downloadBtns.forEach((btn) => {
          btn.addEventListener('click', async () => {
            const docId = btn.getAttribute('data-doc-id');
            if (!docId) return;
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.textContent = 'Descarregant...';

            try {
              const res = await fetch('/.netlify/functions/documents-soci', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: 'download', sessionToken, docId })
              });
              const data = await res.json();
              if (!res.ok || !data.fileBase64) {
                throw new Error(data.error || "No s'ha pogut descarregar el document.");
              }

              const byteChars = atob(data.fileBase64);
              const byteNumbers = new Array(byteChars.length);
              for (let i = 0; i < byteChars.length; i++) {
                byteNumbers[i] = byteChars.charCodeAt(i);
              }
              const byteArray = new Uint8Array(byteNumbers);
              const blob = new Blob([byteArray], { type: 'application/pdf' });
              const blobUrl = URL.createObjectURL(blob);

              const link = document.createElement('a');
              link.href = blobUrl;
              link.download = data.fileName || `${docId}.pdf`;
              document.body.appendChild(link);
              link.click();
              document.body.removeChild(link);
              setTimeout(() => URL.revokeObjectURL(blobUrl), 5000);
            } catch (err) {
              alert(err.message || "Error descarregant l'arxiu.");
            } finally {
              btn.innerHTML = originalHtml;
              btn.disabled = false;
            }
          });
        });
      }

      // Comprovar si ja hi ha una sessió vàlida guardada al navegador
      async function checkExistingSession() {
        const savedToken = localStorage.getItem(STORAGE_KEY);
        if (!savedToken) return;

        if (gateBox) gateBox.classList.add('hidden');
        if (sessionLoading) sessionLoading.classList.remove('hidden');

        try {
          const res = await fetch('/.netlify/functions/documents-soci', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'get-documents', sessionToken: savedToken })
          });
          const data = await res.json();
          if (res.ok && data.valid) {
            renderUnlockedDocuments(data.soci, data.documents, savedToken);
            return;
          }
        } catch (e) {
          // Si falla la connexió o ha caducat, netegem i mostrem el formulari
        }

        localStorage.removeItem(STORAGE_KEY);
        if (sessionLoading) sessionLoading.classList.add('hidden');
        if (gateBox) gateBox.classList.remove('hidden');
      }

      checkExistingSession();

      // Pas 1: Enviar codi al correu
      if (formSendCode) {
        formSendCode.addEventListener('submit', async (e) => {
          e.preventDefault();
          clearError();

          const email = (inputEmail?.value || '').trim();
          if (!email) return;

          const originalText = btnSendCode.innerHTML;
          btnSendCode.disabled = true;
          btnSendCode.innerHTML = '<span>Comprovant soci i enviant codi...</span>';

          try {
            const res = await fetch('/.netlify/functions/documents-soci', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'send-code', email })
            });
            const data = await res.json();

            if (!res.ok || !data.success) {
              throw new Error(data.error || "No s'ha pogut enviar el codi.");
            }

            currentChallengeToken = data.challengeToken;
            currentEmail = email;

            if (displayTargetEmail) displayTargetEmail.textContent = email;
            if (stepEmailContainer) stepEmailContainer.classList.add('hidden');
            if (stepCodeContainer) stepCodeContainer.classList.remove('hidden');
            if (inputOtpCode) {
              inputOtpCode.value = '';
              inputOtpCode.focus();
            }
          } catch (err) {
            showError(err.message || "S'ha produït un error de connexió.");
          } finally {
            btnSendCode.disabled = false;
            btnSendCode.innerHTML = originalText;
          }
        });
      }

      // Pas 2: Verificar el codi de 6 xifres
      if (formVerifyCode) {
        formVerifyCode.addEventListener('submit', async (e) => {
          e.preventDefault();
          clearError();

          const code = (inputOtpCode?.value || '').trim();
          if (!code || !currentChallengeToken) return;

          const originalText = btnVerifyCode.innerHTML;
          btnVerifyCode.disabled = true;
          btnVerifyCode.innerHTML = '<span>Verificant codi...</span>';

          try {
            const res = await fetch('/.netlify/functions/documents-soci', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'verify-code',
                challengeToken: currentChallengeToken,
                code
              })
            });
            const data = await res.json();

            if (!res.ok || !data.valid) {
              throw new Error(data.error || 'Codi incorrecte.');
            }

            localStorage.setItem(STORAGE_KEY, data.sessionToken);
            renderUnlockedDocuments(data.soci, data.documents, data.sessionToken);
          } catch (err) {
            showError(err.message || 'Error en verificar el codi.');
          } finally {
            btnVerifyCode.disabled = false;
            btnVerifyCode.innerHTML = originalText;
          }
        });
      }

      // Botó per tornar al pas d'introduir correu
      if (btnBackEmail) {
        btnBackEmail.addEventListener('click', () => {
          clearError();
          currentChallengeToken = '';
          if (stepCodeContainer) stepCodeContainer.classList.add('hidden');
          if (stepEmailContainer) stepEmailContainer.classList.remove('hidden');
        });
      }

      // Tancar sessió
      if (btnLogout) {
        btnLogout.addEventListener('click', () => {
          localStorage.removeItem(STORAGE_KEY);
          currentChallengeToken = '';
          if (unlockedBox) unlockedBox.classList.add('hidden');
          if (stepCodeContainer) stepCodeContainer.classList.add('hidden');
          if (stepEmailContainer) stepEmailContainer.classList.remove('hidden');
          if (gateBox) gateBox.classList.remove('hidden');
        });
      }
    });
  </script>
</Layout>
