---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="ca">
  <head>
    <!-- Widget for Netlify Identity per gestionar invitacions des de la portada -->
    <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script>
      if (window.location.hash && (
        window.location.hash.includes('_token=') || 
        window.location.hash.includes('recovery_token') || 
        window.location.hash.includes('invite_token')
      )) {
        window.location.href = '/admin/' + window.location.hash;
      }
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - AFA Casa Nostra</title>
    <!-- Utilitzarem l'URL real del logo per l'icona -->
    <link rel="icon" type="image/png" href="/images/logo-afa.png" />
  </head>
  <body class="flex flex-col min-h-screen">
    <header class="bg-white shadow-sm sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <img src="/images/logo-afa-email.png" alt="Logo AFA Casa Nostra" class="h-14" />
        </a>
        <nav class="hidden md:flex gap-5 font-medium text-brand-blue items-center text-sm lg:text-base">
          <a href="/" class="hover:text-brand-accent transition">Inici</a>
          <a href="/afa" class="hover:text-brand-accent transition">L'AFA</a>
          
          <!-- Dropdown Serveis simple (CSS hover) -->
          <div class="relative group">
            <button class="hover:text-brand-accent transition flex items-center gap-1">
              Serveis ▾
            </button>
            <div class="absolute top-full left-0 mt-2 w-48 bg-white shadow-lg rounded-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all border border-slate-100 flex flex-col overflow-hidden">
              <!-- Amagat temporalment (no gestionat per l'AFA actualment):
              <a href="/serveis/menjador" class="px-4 py-3 hover:bg-slate-50 border-b border-slate-50">Menjador</a>
              <a href="/serveis/extraescolars" class="px-4 py-3 hover:bg-slate-50 border-b border-slate-50">Extraescolars</a>
              -->
              <a href="/serveis/llibres" class="px-4 py-3 hover:bg-slate-50 border-b border-slate-50">Llibres de Text</a>
              <a href="/serveis/tallers" class="px-4 py-3 hover:bg-slate-50">Tallers Famílies</a>
            </div>
          </div>

          <a href="/agenda" class="hover:text-brand-accent transition">Agenda</a>
          <a href="/actualitat" class="hover:text-brand-accent transition">Actualitat</a>
          <a href="/documents" class="hover:text-brand-accent transition">Documents</a>
          <a href="/carnet" class="hover:text-brand-accent transition">El meu Carnet</a>
          <a href="/contacte" class="hover:text-brand-accent transition">Contacte</a>
        </nav>
        
        <div class="hidden md:flex items-center gap-3">
          <a href="/contacte" class="bg-brand-blue text-white px-4 py-2 rounded-lg font-medium hover:bg-brand-blue/90 transition text-sm">
            Fes-te Soci/a
          </a>
        </div>

        <div class="md:hidden flex items-center">
          <button id="mobile-menu-btn" type="button" aria-label="Menú de navegació" aria-expanded="false" class="text-brand-blue p-2 rounded-lg hover:bg-slate-100 transition flex items-center gap-1.5 focus:outline-none cursor-pointer">
            <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            <span class="text-sm font-bold">Menú</span>
          </button>
        </div>
      </div>

      <!-- Menú Desplegable Mòbil -->
      <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-slate-100 shadow-xl px-5 py-4 transition-all">
        <nav class="flex flex-col space-y-1 font-medium text-brand-blue text-base">
          <a href="/" class="py-2.5 border-b border-slate-50 hover:text-brand-accent transition flex items-center justify-between">
            <span>Inici</span> <span class="text-slate-300">&rarr;</span>
          </a>
          <a href="/afa" class="py-2.5 border-b border-slate-50 hover:text-brand-accent transition flex items-center justify-between">
            <span>L'AFA (Qui som)</span> <span class="text-slate-300">&rarr;</span>
          </a>
          
          <!-- Subapartat Serveis al mòbil -->
          <div class="py-2.5 border-b border-slate-50">
            <span class="text-xs uppercase text-slate-400 font-bold tracking-wider block mb-2">Serveis</span>
            <div class="pl-3 space-y-2 text-sm text-slate-700">
              <a href="/serveis/llibres" class="block py-1 hover:text-brand-accent transition">📚 Llibres de Text</a>
              <a href="/serveis/tallers" class="block py-1 hover:text-brand-accent transition">🎨 Tallers Famílies</a>
            </div>
          </div>

          <a href="/agenda" class="py-2.5 border-b border-slate-50 hover:text-brand-accent transition flex items-center justify-between">
            <span>📅 Agenda i Festes</span> <span class="text-slate-300">&rarr;</span>
          </a>
          <a href="/actualitat" class="py-2.5 border-b border-slate-50 hover:text-brand-accent transition flex items-center justify-between">
            <span>📰 Actualitat</span> <span class="text-slate-300">&rarr;</span>
          </a>
          <a href="/documents" class="py-2.5 border-b border-slate-50 hover:text-brand-accent transition flex items-center justify-between">
            <span>📂 Documents i Actes</span> <span class="text-slate-300">&rarr;</span>
          </a>
          <a href="/carnet" class="py-2.5 border-b border-slate-50 hover:text-brand-accent transition flex items-center justify-between">
            <span>💳 El meu Carnet</span> <span class="text-slate-300">&rarr;</span>
          </a>
          <a href="/contacte" class="py-2.5 border-b border-slate-50 hover:text-brand-accent transition flex items-center justify-between">
            <span>✉️ Contacte</span> <span class="text-slate-300">&rarr;</span>
          </a>

          <div class="pt-4">
            <a href="/contacte" class="block text-center bg-brand-blue text-white py-3 rounded-xl font-bold shadow-sm hover:bg-brand-blue/90 transition">
              Fes-te Soci/a
            </a>
          </div>
        </nav>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-brand-blue text-white mt-12 py-10">
      <div class="max-w-6xl mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-8">
        <div>
          <h3 class="font-bold text-lg mb-4">AFA Casa Nostra</h3>
          <p class="text-blue-100 text-sm">Escola Casa Nostra<br/>Banyoles / Porqueres</p>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-4">L'Associació</h3>
          <ul class="text-blue-100 text-sm space-y-2">
            <li><a href="/afa" class="hover:text-white transition">Qui som i Comissions</a></li>
            <li><a href="/documents" class="hover:text-white transition">Transparència i Actes</a></li>
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-4">Ajuda</h3>
          <ul class="text-blue-100 text-sm space-y-2">
            <li><a href="/contacte" class="hover:text-white transition">Formulari de Contacte</a></li>
            <li><a href="/pmf" class="hover:text-white transition">Preguntes Freqüents</a></li>
            <li><a href="/admin/index.html" class="hover:text-white transition">Accés Junta (CMS)</a></li>
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-4">Contacte</h3>
          <p class="text-blue-100 text-sm mb-2"><a href="mailto:afa@escolacasanostra.cat" class="hover:text-white transition">afa@escolacasanostra.cat</a></p>
        </div>
      </div>
    </footer>

    <script>
      function initMobileMenu() {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        const hamburger = document.getElementById('hamburger-icon');
        const close = document.getElementById('close-icon');

        if (!btn || !menu) return;

        // Remove any previous listener by cloning or direct toggle
        btn.onclick = (e) => {
          e.stopPropagation();
          const isHidden = menu.classList.contains('hidden');
          if (isHidden) {
            menu.classList.remove('hidden');
            btn.setAttribute('aria-expanded', 'true');
            if (hamburger) hamburger.classList.add('hidden');
            if (close) close.classList.remove('hidden');
          } else {
            menu.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            if (hamburger) hamburger.classList.remove('hidden');
            if (close) close.classList.add('hidden');
          }
        };

        // Tancar en clicar fora del menú
        document.addEventListener('click', (e) => {
          if (!menu.contains(e.target as Node) && !btn.contains(e.target as Node)) {
            menu.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
            if (hamburger) hamburger.classList.remove('hidden');
            if (close) close.classList.add('hidden');
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMobileMenu);
      } else {
        initMobileMenu();
      }
      document.addEventListener('astro:page-load', initMobileMenu);
    </script>
  </body>
</html>
